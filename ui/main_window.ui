  <property name="styleSheet">
   <string notr="true">QMainWindow {
	background-color: #81D8D0; /* Tiffany Blue */
	color: #333333;
}
QWidget {
	font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;;
	font-size: 10pt;
    color: #333333;
}
QListWidget {
	background-color: #E0F2F1; /* Lighter Teal/Cyan */
	border: none;
	color: #333333;
	outline: 0;
}
QListWidget::item {
	height: 40px;
	padding-left: 10px;
}
QListWidget::item:selected {
	background-color: #00897B; /* Darker Teal for selection */
	color: white;
}
QListWidget::item:hover {
	background-color: #B2DFDB;
}
QGroupBox {
	border: 1px solid #00897B;
	border-radius: 5px;
	margin-top: 20px;
	color: #00695C;
	font-weight: bold;
}
QGroupBox::title {
	subcontrol-origin: margin;
	left: 10px;
	padding: 0 3px 0 3px;
}
QPushButton {
	background-color: #E0F7FA;
	color: #006064;
	border: 1px solid #00897B;
	border-radius: 4px;
	padding: 5px 15px;
}
QPushButton:hover {
	background-color: #B2DFDB;
}
QPushButton:pressed {
	background-color: #80CBC4;
}
QPushButton#btn_toggle_running {
	background-color: #2e7d32; /* Default Green for Start */
    color: white;
	border-color: #1b5e20;
    font-weight: bold;
    font-size: 11pt;
}
QPushButton#btn_toggle_running:checked {
    background-color: #c62828; /* Red for Stop */
    border-color: #b71c1c;
}
QPushButton#btn_toggle_running:hover {
    opacity: 0.9;
}
QTabWidget::pane {
	border: 1px solid #00897B;
	background-color: #FFFFFF;
}
QTabBar::tab {
	background-color: #E0F2F1;
	color: #00695C;
	padding: 8px 20px;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}
QTabBar::tab:selected {
	background-color: #FFFFFF;
	color: #004D40;
	border-bottom: 2px solid #00897B;
}
QTextBrowser {
	background-color: #E0F2F1; /* Light Tiffany Blue to match theme */
	color: #004D40;
	border: 1px solid #00897B;
	font-family: &quot;Consolas&quot;, &quot;Courier New&quot;;
}
QComboBox {
	background-color: #E0F7FA;
	color: #006064;
	border: 1px solid #00897B;
	padding: 5px;
}
QComboBox::drop-down {
	border: 0px;
}
/* 针对三个状态列表的特殊样式 */
#list_running, #list_queue, #list_waiting {
    background-color: #FFFFFF; 
    border: 1px solid #B2DFDB; 
    border-radius: 4px;
}
#list_running::item, #list_queue::item, #list_waiting::item {
    border-bottom: 1px solid #E0F2F1;
    height: 30px;
}
</string>
